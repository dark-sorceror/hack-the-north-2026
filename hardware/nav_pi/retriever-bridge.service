# systemd unit: the bridge starts on boot and restarts if it dies.
#
# A robot whose bridge needs someone to ssh in and start it is a robot that
# does not move after a battery swap. Install with hardware/nav_pi/setup.sh.
[Unit]
Description=Retriever Pi bridge (laptop <-> motors/arms, with watchdog)
After=network-online.target
Wants=network-online.target
# Never give up restarting. systemd's default stops after 5 failures in 10 s,
# which a bridge waiting for an unplugged wheel adapter reaches in 5 seconds.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/retriever
# The bridge arguments are what hardware/nav_pi/setup.sh was given: --driver fake by default,
#   bash hardware/nav_pi/setup.sh --driver real          for the DDSM115 wheels (adapter auto-found)
# With --driver real and the wheel adapter unplugged, the bridge exits and
# systemd retries every second, so plugging it in later is enough.
#
# --host= (the EMPTY host) binds every address, IPv4 AND IPv6. On the direct
# cable to the laptop the Pi may have only an IPv6 link-local address
# (fe80::...%eth0, no DHCP, no IPv4), where 0.0.0.0 is unreachable. "::" is not
# the fix: asyncio sets IPV6_V6ONLY, so "::" alone refuses every IPv4 client
# (venue Wi-Fi, Internet Sharing's 192.168.2.x). The empty host makes asyncio
# open one socket per family, and it binds even before any link is up.
ExecStart=/usr/bin/python3 __HOME__/retriever/scripts/run_bridge.py --host= --port 7777 __BRIDGE_ARGS__
Restart=always
RestartSec=1
# Serial ports (arm, wheels) and GPIO (e-stop, vacuum relay).
SupplementaryGroups=dialout gpio

[Install]
WantedBy=multi-user.target
