diff --git a/src/lerobot/utils/control_utils.py b/src/lerobot/utils/control_utils.py
index 94cd82fa..12b65f50 100644
--- a/src/lerobot/utils/control_utils.py
+++ b/src/lerobot/utils/control_utils.py
@@ -141,6 +141,29 @@ def init_keyboard_listener():
         logging.warning(
             "Headless environment detected. On-screen cameras display and keyboard inputs will not be available."
         )
+        # Headless (e.g. plain SSH): pynput needs an X display, so the arrow-key
+        # controls are dead and episodes run their full duration with no way to
+        # re-record a bad one. The control flow is just this dict, so drive it
+        # from stdin instead - works over SSH and needs no X server.
+        import sys as _sys
+        import threading as _threading
+
+        def _stdin_reader():
+            msg = ('[headless controls] n = end episode | '
+                   'r = re-record it | q = stop session')
+            print(msg, flush=True)
+            for line in _sys.stdin:
+                cmd = line.strip().lower()
+                if cmd == 'n':          # bare ENTER deliberately ignored
+                    events['exit_early'] = True
+                elif cmd == 'r':
+                    events['rerecord_episode'] = True
+                    events['exit_early'] = True
+                elif cmd == 'q':
+                    events['stop_recording'] = True
+                    events['exit_early'] = True
+
+        _threading.Thread(target=_stdin_reader, daemon=True).start()
         listener = None
         return listener, events
 
