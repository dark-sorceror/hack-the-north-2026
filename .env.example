# Reference only. Export variables in your shell; scripts do not load this file.
# Navigation simulation does not need a provider key.
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-flash
OMNI_VOICE=Ethan
OMNI_TIMEOUT=60

# Optional OpenAI voice adapter / compatible planner provider.
OPENAI_API_KEY=
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=
PLANNER_API_KEY=

# Hardware addresses and camera mounting are CLI arguments.
# See docs/development.md for entry points and environment requirements.
