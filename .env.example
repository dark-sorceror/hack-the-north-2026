# Reference only: export these variables in each process; no automatic .env loading.
ROBOT_TOKEN="test-voice-token-2026-09-19-long-enough"
ROBOT_URL=ws://127.0.0.1:8766
CAMERA_URL=ws://10.0.0.112:8767
BIRDSEYE_URL=ws://10.0.0.112:8765/birdseye
NAV2_BRIDGE_URL=ws://127.0.0.1:8770
ARM101_BRIDGE_URL=ws://127.0.0.1:8771
VOICE_URL=ws://127.0.0.1:8765
# Cloud process only:
YIBU_API_KEY="replace-with-private-provider-key"
YIBU_MODEL=qwen3.5-omni-plus-realtime
YIBU_ENDPOINT=wss://yibuapi.com/v1/realtime
YIBU_AUDIT_LOG=artifacts/yibu_api_calls.jsonl
# Optional Qwen task decomposition through DashScope:
DASHSCOPE_API_KEY="replace-with-private-dashscope-key"
DASHSCOPE_DECOMPOSER_MODEL=qwen3.5-plus
VLA_DECOMPOSER_ENABLED=0
ROBOT_WATCHDOG_TIMEOUT=30
