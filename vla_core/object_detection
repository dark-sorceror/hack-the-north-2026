from ultralytics import YOLOWorld
import cv2

# Load the pretrained model (v2-s is optimized for speed on edge/local GPUs)
model = YOLOWorld("yolov8s-worldv2.pt")

def detect_target_object(camera_frame, spoken_command_noun):
    # Dynamically set the vocabulary based on the parsed voice command
    model.set_classes([spoken_command_noun])
    
    # Execute inference on the current OpenCV frame from the top camera
    results = model.predict(camera_frame, conf=0.1)
    
    # Extract the bounding box coordinates for MoveIt 2
    for result in results:
        boxes = result.boxes
        if len(boxes) > 0:
            # Return the highest confidence bounding box [x1, y1, x2, y2]
            return boxes.xyxy[0].tolist() 
            
    return None # Triggers the conversational fallback